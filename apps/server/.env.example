# Copy to .env next to docker-compose.yml. Used by both services in that file.

# Navidrome, reachable from inside the container (required).
NAVIDROME_URL=http://navidrome:4533

# The address people use from outside (the apps use it for Quick Connect and LAN discovery).
# Leave empty to answer with the server's LAN address instead.
PUBLIC_URL=

# The port the engine is published on, and the name shown when an app finds it on the network.
ENGINE_PORT=8080
ENGINE_NAME=Home

# Optional: Last.fm (API account at last.fm/api).
# Only for your own Last.fm API account; leave empty to use the app's (docs/deploy-server.md#lastfm)
LASTFM_API_KEY=
LASTFM_API_SECRET=
