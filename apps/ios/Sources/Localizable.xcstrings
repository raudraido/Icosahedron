          "stringUnit": {
            "state": "translated",
            "value": "Serveri andmed"
          }
        }
      }
    },
    "What the sync server stores for your account. Clearing does not touch anything on your players.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida sünkroonimisserver sinu konto jaoks hoiab. Kustutamine ei puuduta midagi sinu pleieritel."
          }
        }
      }
    },
