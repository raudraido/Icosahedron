<?xml version="1.0" encoding="utf-8"?>
<!-- 108 dp layer, 72 dp of it visible: the logo (460 x 436) spans the whole visible width, so its left and right
     points touch the edge of a circular mask but are not cut. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="72dp" android:height="68.2dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/logo" />
    </item>
</layer-list>
